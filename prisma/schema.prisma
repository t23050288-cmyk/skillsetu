generator client {
  provider = "prisma-client-js"
}

// Local dev = SQLite (zero setup, works offline at the venue).
// Production = Postgres on Supabase free tier: only this line changes.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  city          String?
  language      String   @default("en")
  role          String   @default("LEARNER") // LEARNER | EMPLOYER
  headline      String?
  passportId    String?  @unique
  createdAt     DateTime @default(now())

  submissions   Submission[]
  credentials   Credential[]
  applications  Application[]
  opportunities Opportunity[]
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Challenge {
  id         String       @id @default(cuid())
  slug       String       @unique
  title      String
  titleHi    String?
  skill      String
  level      String       @default("beginner")
  minutes    Int          @default(15)
  brief      String
  briefHi    String?
  rubric     String       // JSON: [{key,label,weight,hint}]
  sample     String?
  active     Boolean      @default(true)
  submissions Submission[]
}

model Submission {
  id          String      @id @default(cuid())
  userId      String
  challengeId String
  content     String
  evidenceUrl String?
  score       Int?
  level       String?
  dimensions  String?     // JSON
  feedback    String?
  strength    String?
  gap         String?
  grader      String?     // which model produced the grade
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  credential  Credential?
}

model Credential {
  id          String   @id @default(cuid())
  publicId    String   @unique
  userId      String
  challengeId String?
  submissionId String? @unique
  title       String
  skill       String
  score       Int
  level       String
  evidenceHash String
  issuedAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
}

model Opportunity {
  id          String   @id @default(cuid())
  employerId  String
  title       String
  org         String
  city        String
  type        String   @default("JOB") // JOB | INTERNSHIP | GIG | SCHOLARSHIP
  remote      Boolean  @default(false)
  description String
  skills      String   // JSON array of skill tags
  payText     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  employer    User          @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id            String   @id @default(cuid())
  opportunityId String
  userId        String
  status        String   @default("APPLIED") // APPLIED | SHORTLISTED | REJECTED
  matchScore    Int      @default(0)
  matchNote     String?
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
}
