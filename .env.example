# ---- Database (free tier: Supabase / Neon Postgres, or local SQLite) ----
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# ---- Session signing ----
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- AI (all optional; app falls back to the local heuristic engine) ----
# 1) OmniRoute free gateway: npx -y omniroute  ->  http://localhost:20128/v1
AI_BASE_URL="http://localhost:20128/v1"
AI_API_KEY=""
AI_MODEL="auto"
# 2) Google Gemini free tier (recommended, no card needed)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# 3) Groq free tier
GROQ_API_KEY=""
# 4) OpenRouter free models
OPENROUTER_API_KEY=""

# ---- ElevenLabs free tier (voice for low-literacy users + sponsor prize) ----
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
